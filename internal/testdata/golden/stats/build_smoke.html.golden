          <th data-sort-type="num">records</th>
          <th data-sort-type="num">modules</th>
          <th data-sort-type="num">site_classes</th>
          <th data-sort-type="num">recent_records</th>
        </tr></thead>
        <tbody>
        
          <tr>
            <td>h5</td><td>debian</td>
            <td class="num">4</td>
            <td class="num">4</td>
            <td class="num">4</td>
            <td class="num">0</td>
          </tr>
        
          <tr>
            <td>h1</td><td>ubuntu</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">0</td>
          </tr>
        
          <tr>
            <td>h2</td><td>ubuntu</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">0</td>
          </tr>
        
          <tr>
            <td>h3</td><td>ubuntu</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">0</td>
          </tr>
        
          <tr>
            <td>h4</td><td>rhel</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">2</td>
            <td class="num">0</td>
          </tr>
        
          <tr>
            <td>h6</td><td>rhel</td>
            <td class="num">1</td>
            <td class="num">1</td>
