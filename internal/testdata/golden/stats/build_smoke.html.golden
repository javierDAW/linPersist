          <th>sample_host</th>
          <th>sample_locus</th>
          <th>sample_snippet</th>
        </tr></thead>
        <tbody>
        
          <tr>
            <td>rhel</td><td>systemd</td><td>systemd.unit</td>
            <td class="hash">beacon-svc-n</td>
            <td class="num">3</td>
            <td>h4</td>
            <td class="path">/etc/systemd/system/beacon.service</td>
            <td class="snippet">beacon-svc-norm</td>
          </tr>
        
          <tr>
            <td>ubuntu</td><td>cron</td><td>cron.d</td>
            <td class="hash">cron-singlet</td>
            <td class="num">3</td>
