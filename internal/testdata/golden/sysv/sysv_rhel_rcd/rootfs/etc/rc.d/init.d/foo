#!/bin/bash
#
# foo  - Foo daemon
# chkconfig: 2345 99 01
# description: Foo daemon RHEL-style init script
#

. /etc/rc.d/init.d/functions

DAEMON=/usr/sbin/foo

start() {
    daemon $DAEMON
}

stop() {
    killproc $DAEMON
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 2 ;;
esac
