# Implant template: ldso-confd-hijack (L2, armed)
#
# T1574.006 (Hijack Execution Flow: Dynamic Linker — library search path
# injection). Drops an /etc/ld.so.conf.d drop-in that adds an
# attacker-controlled directory to the dynamic linker's search path, so a
# malicious lib placed there shadows a real one. Non-destructive (unlike
# ld.so.preload, a non-existent search dir is silently ignored by ld.so),
# so it does not break the lab host. The ldso module records it as
# site_class ldso.confd; the unpackaged drop-in is a fleet singleton.
#
# Variables: ${conf_file}, ${lib_dir}

RUN mkdir -p /etc/ld.so.conf.d && \
    printf '%s\n' \
        '# Provisioned by ops-ld (DO NOT EDIT)' \
        '${lib_dir}' \
        > ${conf_file} && \
    chown root:root ${conf_file} && \
    chmod 0644 ${conf_file}
