# APT2 implant: apt2-ldso-shadow (dynamic-linker library hijack via
# ld.so.conf.d). A .conf drop-in adds a non-standard search dir holding a
# .so whose basename collides with a package-owned system library
# (libc.so.6). ld.so resolves the SONAME to the planted copy, hijacking
# every process that loads it. The shadow record's exec_target is the
# planted .so -> ld_library_shadows_packaged + non_package_path ->
# ld_library_shadow_implant (critical). Variables: (none)
RUN mkdir -p /opt/.perflib && \
    printf '%s\n' 'PLANTED-SHADOW-LIB' > /opt/.perflib/libc.so.6 && \
    chown root:root /opt/.perflib/libc.so.6 && chmod 0755 /opt/.perflib/libc.so.6 && \
    printf '%s\n' '# perf tuning' '/opt/.perflib' > /etc/ld.so.conf.d/zz-perf.conf && \
    chown root:root /etc/ld.so.conf.d/zz-perf.conf && chmod 0644 /etc/ld.so.conf.d/zz-perf.conf
