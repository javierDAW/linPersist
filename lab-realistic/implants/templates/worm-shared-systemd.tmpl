# Implant template: worm-shared-systemd (L5, armed)
#
# See worm-shared-cron.tmpl for the design rationale. The payload
# body MUST be byte-identical to the cron and profile variants.
#
# Variables (from catalog.vars): ${unit_name}, ${description}

# === SHARED PAYLOAD BODY (keep byte-identical across worm-shared-*) ===
RUN mkdir -p /usr/local/sbin && \
    printf '%s\n' \
        '#!/bin/sh' \
        '# INERT WORM PAYLOAD MARKER -- lab artifact, not real malware.' \
        '# This script is byte-identical across all 3 worm-shared-* hosts.' \
        '# Q6 catches: same exec_target_sha256 across hosts with different invocation vectors.' \
        'echo "lab-worm host=$$(hostname) ts=$$(date -Is)" >> /tmp/.implant-trace' \
        > /usr/local/sbin/sync-agent && \
    chmod 0755 /usr/local/sbin/sync-agent

# === Vector: systemd unit ===
RUN mkdir -p /etc/systemd/system && \
    printf '%s\n' \
        '[Unit]' \
        'Description=${description}' \
        'After=network.target' \
        '' \
        '[Service]' \
        'Type=simple' \
        'ExecStart=/usr/local/sbin/sync-agent' \
        'Restart=on-failure' \
        '' \
        '[Install]' \
        'WantedBy=multi-user.target' \
        > /etc/systemd/system/${unit_name} && \
    chown root:root /etc/systemd/system/${unit_name} && \
    chmod 0644 /etc/systemd/system/${unit_name}
