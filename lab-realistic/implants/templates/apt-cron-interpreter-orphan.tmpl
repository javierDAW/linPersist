# APT implant: apt-cron-interpreter-orphan (packaged interpreter, parked payload)
#
# Real shape (T1059.004 / T1543.002, Kinsing/TeamTNT-style): a cron.d job
# whose command is a PACKAGE-OWNED interpreter (/bin/bash, essential)
# running a parked, non-package script under a dot-dir in /opt.
# exec_target resolves to the owned bash (no non_package_path /
# exec_target_orphan / interpreter_in_tmp), so pre-duel this only surfaced
# via LFA. The new interpreter_runs_orphan_script signal resolves the
# SCRIPT ARGUMENT through provenance -> orphan ->
# interpreter_executes_unmanaged_script (high).
#
# bash (not python3) is used on purpose: it is Essential, hence present
# and package-owned on every Debian/Rocky base, so the "owned interpreter"
# premise actually holds in the booted lab and the new signal is exercised
# in ISOLATION (an interpreter the base lacks would resolve orphan and the
# old non_package signal would catch it, defeating the test).
#
# Variables: ${cron_file}, ${schedule}, ${script}

RUN mkdir -p /etc/cron.d /opt/.sysmon && \
    printf '%s\n' \
        '#!/bin/bash' \
        'while :; do sleep 3600; done' \
        > ${script} && \
    chown root:root ${script} && \
    chmod 0755 ${script} && \
    printf '%s\n' '${schedule} root /bin/bash ${script}' > ${cron_file} && \
    chown root:root ${cron_file} && \
    chmod 0644 ${cron_file}
