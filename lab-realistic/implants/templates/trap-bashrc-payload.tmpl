# Implant template: trap-bashrc-payload (L2, armed)
#
# T1546.005 (Event Triggered Execution: Trap). Drops a profile.d
# script whose body installs a bash `trap` handler bound to EXIT
# that runs an inert payload under /tmp. linpersist's profile
# module fires trap_command + trap_exit_handler + trap_command_in_tmp,
# and the new ExtractExecTarget surface populates exec_target from
# the script body so Q12 can cluster this with sibling cron / systemd
# arms when present.
#
# Variables: ${profile_file}, ${payload_path}

RUN mkdir -p "$$(dirname ${payload_path})" && \
    printf '%s\n' \
        '#!/bin/sh' \
        '# INERT IMPLANT MARKER -- lab artifact, not real malware.' \
        'echo "lab-implant trap-bashrc-payload host=$$(hostname) ts=$$(date -Is)" >> /tmp/.implant-trace' \
        > ${payload_path} && \
    chmod 0755 ${payload_path}

RUN mkdir -p /etc/profile.d && \
    printf '%s\n' \
        '# Provisioned by ops-trap helper (DO NOT EDIT)' \
        "trap '${payload_path}' EXIT" \
        'export PATH="$$PATH:/opt/local/bin"' \
        > ${profile_file} && \
    chown root:root ${profile_file} && \
    chmod 0644 ${profile_file}
