# APT2 implant: apt2-python-hook (Python interpreter startup persistence).
# A code .pth in the python site/dist-packages dir runs in EVERY python
# invocation (CPython exec()s a line beginning `import`). runtimeinit
# collects it as runtime.python, ExecTarget=self -> non_package_path ->
# python_runtime_hook_unmanaged. The site dir is globbed so this works on
# any distro (Arch site-packages, Debian dist-packages, ...) -- and being
# a non-package file, it doubles as a pacman/portage provenance check on
# Arch/Gentoo. Variables: (none)
RUN PYDIR=$(ls -d /usr/lib/python3*/site-packages /usr/lib/python3*/dist-packages 2>/dev/null | head -1); \
    PYDIR=${PYDIR:-/usr/lib/python3/dist-packages}; mkdir -p "$PYDIR"; \
    printf '%s\n' 'import os; os.system("/usr/bin/id > /tmp/.pyhook 2>&1")' > "$PYDIR/zz-telemetry.pth" && \
    chown root:root "$PYDIR/zz-telemetry.pth" && chmod 0644 "$PYDIR/zz-telemetry.pth"
