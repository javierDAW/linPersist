# APT2 implant: apt2-systemd-pathunit (systemd .path file-trigger
# persistence). A .path unit watches a dropfile and, when it changes,
# systemd starts the payload .service. The .path looks innocuous (no
# ExecStart of its own); the payload runs a non-package /opt binary. The
# new relationship-edge work records the trigger->payload edge:
# systemd_path_trigger + Relations [PathModified=..., Unit=zz-payload.service]
# on the .path, so the backend joins the innocuous trigger to the payload
# service (which surfaces on its own via LFA / non_package_path).
# This is a BACKEND/Q12 correlation feature, NOT a Q7 rule. Variables: (none)
RUN mkdir -p /opt/.p && \
    printf '%s\n' '#!/bin/sh' 'sleep 1' > /opt/.p/agent && \
    chown root:root /opt/.p/agent && chmod 0755 /opt/.p/agent && \
    printf '%s\n' '[Unit]' 'Description=Cache warmer trigger' '[Path]' 'PathModified=/tmp/.cachetrigger' 'Unit=zz-payload.service' '[Install]' 'WantedBy=multi-user.target' > /etc/systemd/system/zz-watch.path && \
    printf '%s\n' '[Unit]' 'Description=Cache warmer' '[Service]' 'Type=simple' 'ExecStart=/opt/.p/agent' '[Install]' 'WantedBy=multi-user.target' > /etc/systemd/system/zz-payload.service && \
    chown root:root /etc/systemd/system/zz-watch.path /etc/systemd/system/zz-payload.service && \
    chmod 0644 /etc/systemd/system/zz-watch.path /etc/systemd/system/zz-payload.service
