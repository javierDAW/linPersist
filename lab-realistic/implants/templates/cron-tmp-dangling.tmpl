# Implant template: cron-tmp-dangling (L1, orphan variant)
#
# Companion to cron-tmp-payload: same cron entry shape, but the
# payload file is NEVER created. The cron schedule references a
# /tmp/X path that does not exist. This is what triggers
# exec_target_orphan in linpersist v0.1.0 (which is a "file-not-found"
# check until v0.2.0 wires real dpkg/rpm provenance).
#
# Variables (from catalog.vars): ${cron_file}, ${schedule}, ${payload_path}.

RUN mkdir -p $$(dirname ${cron_file}) && \
    printf '%s\n' \
        '# Auto-generated by sync-helper provisioner (DO NOT EDIT)' \
        'SHELL=/bin/sh' \
        'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
        '${schedule} root ${payload_path}' \
        > ${cron_file} && \
    chown root:root ${cron_file} && \
    chmod 0644 ${cron_file}
