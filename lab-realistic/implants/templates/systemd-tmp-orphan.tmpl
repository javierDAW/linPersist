# Implant template: systemd-tmp-orphan (L1, orphan variant)
#
# Same systemd unit shape as systemd-tmp-armed, but the payload file
# is NEVER created. ExecStart points at a non-existent /tmp/ path,
# triggering exec_target_orphan.
#
# Variables: ${unit_name}, ${payload_path}, ${description}

RUN mkdir -p /etc/systemd/system && \
    printf '%s\n' \
        '[Unit]' \
        'Description=${description}' \
        'After=network.target' \
        '' \
        '[Service]' \
        'Type=simple' \
        'ExecStart=${payload_path}' \
        'Restart=on-failure' \
        '' \
        '[Install]' \
        'WantedBy=multi-user.target' \
        > /etc/systemd/system/${unit_name} && \
    chown root:root /etc/systemd/system/${unit_name} && \
    chmod 0644 /etc/systemd/system/${unit_name}
