# Implant template: apt-cron-packaged-payload-dir (L5, armed)
#
# APT TTP mirror: APT-style "live off the package tree" persistence -- a
# cron.d entry that runs a real, packaged interpreter against a payload
# the attacker dropped inside a PACKAGE-OWNED directory that the package
# manager does NOT have a recorded digest for (e.g. /usr/lib/python3.11/
# site-packages-adjacent, or a vendored module dir). The payload path
# /usr/lib/python3/dist-packages/.cache/sitecustomize.py is UNDER a
# dpkg/rpm-owned directory but is itself an UNMANAGED file (the dir is
# owned, the new file is not a registered package file). LookupPath does
# directory-ownership inference: many provenance implementations mark a
# file "managed" if its parent dir belongs to a package, which would
# SUPPRESS non_package_path. Even if non_package fires, there is no
# orphan (the payload exists) and no /tmp. The cron command is
# /usr/bin/python3 (packaged LOLBin) -> shell_indirect/unqualified do not
# fire (full path). So the only signal is recent_mtime (which the lab
# timestomp-on-build resets for /etc paths, but cron.d IS under /etc so
# mtime gets reset -> even recent_mtime can be dampened). Finding: probes
# whether provenance LookupPath infers ownership from parent directory
# and thereby blinds non_package_path on payloads parked in owned dirs.
#
# Variables: ${cron_file}, ${schedule}, ${payload_path}

RUN mkdir -p "$$(dirname ${payload_path})" && \
    printf '%s\n' \
        '#!/usr/bin/python3' \
        '# INERT IMPLANT MARKER -- lab artifact, not real malware.' \
        'import socket, datetime' \
        'open("/tmp/.implant-trace","a").write("lab-implant apt-cron-packaged-payload-dir host=%s ts=%s\n" % (socket.gethostname(), datetime.datetime.now().isoformat()))' \
        > ${payload_path} && \
    chmod 0644 ${payload_path} && \
    chown root:root ${payload_path}

RUN mkdir -p /etc/cron.d && \
    printf '%s\n' \
        '# python site maintenance (managed)' \
        'SHELL=/bin/sh' \
        'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
        '${schedule} root /usr/bin/python3 ${payload_path}' \
        > ${cron_file} && \
    chown root:root ${cron_file} && \
    chmod 0644 ${cron_file}
