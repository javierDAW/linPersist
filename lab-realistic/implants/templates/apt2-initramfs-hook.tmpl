# APT2 implant: apt2-initramfs-hook (early-boot persistence via an
# initramfs-tools hook). The generator copies hooks into the initrd and
# runs them AS ROOT before the real rootfs mounts. /etc/initramfs-tools/
# hooks is empty on a stock host, so this planted, package-unowned hook
# surfaces as boot.initramfs.hook + non_package_path -> initramfs_hook_unmanaged.
# A realistic initramfs-tools hook skeleton (prereqs + copy_exec). Variables: (none)
RUN mkdir -p /etc/initramfs-tools/hooks /opt/.boot && \
    printf '%s\n' '#!/bin/sh' 'sleep 1' > /opt/.boot/agent && \
    chown root:root /opt/.boot/agent && chmod 0755 /opt/.boot/agent && \
    printf '%s\n' '#!/bin/sh' 'PREREQ=""' 'prereqs() { echo "$PREREQ"; }' 'case "$1" in' '  prereqs) prereqs; exit 0 ;;' 'esac' '. /usr/share/initramfs-tools/hook-functions' 'copy_exec /opt/.boot/agent /sbin' > /etc/initramfs-tools/hooks/zz-resume-fix && \
    chown root:root /etc/initramfs-tools/hooks/zz-resume-fix && chmod 0755 /etc/initramfs-tools/hooks/zz-resume-fix
