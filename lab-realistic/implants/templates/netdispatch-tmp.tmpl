# Implant template: netdispatch-tmp (L3, orphan)
#
# T1546 (Event Triggered Execution via NetworkManager dispatcher) -- a
# very common enterprise (RHEL) persistence locus. Drops an executable
# under /etc/NetworkManager/dispatcher.d that NetworkManager runs as
# root on every network up/down event, invoking a payload under /tmp.
# The netdispatch module fires interpreter_in_tmp / exec_target_orphan.
#
# Variables: ${disp_file}, ${payload}

RUN mkdir -p /etc/NetworkManager/dispatcher.d && \
    printf '%s\n' \
        '#!/bin/sh' \
        '# Provisioned by ops-net (DO NOT EDIT)' \
        '${payload} "$$@"' \
        > ${disp_file} && \
    chown root:root ${disp_file} && \
    chmod 0755 ${disp_file}
