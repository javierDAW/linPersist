# Evasion implant: evade-pkg-tamper (append to a package-owned file)
#
# Appends a malicious schedule to /etc/crontab -- a PACKAGE-OWNED file --
# whose command is a packaged LOLBin (/usr/bin/bash), so no non_package /
# orphan / tmp signal fires. linpersist has no package-file integrity
# check (it does not diff against the rpm/dpkg recorded hash), so the only
# thing that catches this is the LFA singleton (the tampered /etc/crontab
# content differs from every clean host). Combined with fleet-wide spread
# it would evade entirely -- motivates a `dpkg --verify` / `rpm -V` style
# package-tamper signal for v1.0.
#
# Variables: ${schedule}, ${cmd}

RUN printf '%s\n' '${schedule} root ${cmd}' >> /etc/crontab
