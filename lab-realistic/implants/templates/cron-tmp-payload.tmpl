# Implant template: cron-tmp-payload (L1)
#
# Rendered by scripts/generate.py via string.Template.safe_substitute.
# Variables (from catalog.vars): ${cron_file}, ${schedule}, ${payload_path}.
#
# IMPORTANT: this template uses string.Template syntax. Plain `$VAR`
# without braces will trigger substitution, so any shell variable
# expansion in the rendered output must be written as `$$VAR` or
# `$$(cmd)` to escape the leading dollar at generate time.

# Inert payload script. Owns root:root, mtime is "now" at build time.
RUN mkdir -p "$$(dirname ${payload_path})" && \
    printf '%s\n' \
        '#!/bin/sh' \
        '# INERT IMPLANT MARKER -- lab artifact, not real malware.' \
        '# If invoked, this only writes a trace line; the lab never invokes it.' \
        'echo "lab-implant cron-tmp-payload host=$$(hostname) ts=$$(date -Is)" >> /tmp/.implant-trace' \
        > ${payload_path} && \
    chmod 0755 ${payload_path}

# The cron drop. 0644 root:root -- exactly what an attacker would set.
RUN printf '%s\n' \
        '# Auto-generated by sync-helper provisioner (DO NOT EDIT)' \
        'SHELL=/bin/sh' \
        'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
        '${schedule} root ${payload_path} --backpressure 20' \
        > ${cron_file} && \
    chown root:root ${cron_file} && \
    chmod 0644 ${cron_file}
