# Implant template: systemd-tmp-armed (L1, armed variant)
#
# A systemd unit whose ExecStart points at a file in /tmp/. The
# payload file IS created on disk -- the "armed" case after the
# attacker has dropped their loader. Mirrors what we'd see post-
# compromise on a host where the implant is actively running.
#
# Variables: ${unit_name}, ${payload_path}, ${description}

# Inert payload.
RUN mkdir -p "$$(dirname ${payload_path})" && \
    printf '%s\n' \
        '#!/bin/sh' \
        '# INERT IMPLANT MARKER -- lab artifact, not real malware.' \
        'echo "lab-implant systemd-tmp-armed host=$$(hostname) ts=$$(date -Is)" >> /tmp/.implant-trace' \
        > ${payload_path} && \
    chmod 0755 ${payload_path}

# Service unit pointing at it.
RUN mkdir -p /etc/systemd/system && \
    printf '%s\n' \
        '[Unit]' \
        'Description=${description}' \
        'After=network.target' \
        '' \
        '[Service]' \
        'Type=simple' \
        'ExecStart=${payload_path}' \
        'Restart=on-failure' \
        '' \
        '[Install]' \
        'WantedBy=multi-user.target' \
        > /etc/systemd/system/${unit_name} && \
    chown root:root /etc/systemd/system/${unit_name} && \
    chmod 0644 /etc/systemd/system/${unit_name}
