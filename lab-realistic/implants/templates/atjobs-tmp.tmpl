# Implant template: atjobs-tmp (L2, orphan)
#
# T1053.002 (Scheduled Task/Job: At). Drops an at(1) spool job that runs
# a payload under /tmp. The atjobs module parses the spool entry and
# fires interpreter_in_tmp / exec_target_orphan on the /tmp command.
#
# Variables: ${job_file}, ${payload}

RUN mkdir -p /var/spool/cron/atjobs && \
    printf '%s\n' \
        '#!/bin/sh' \
        '# atrun uid=0 gid=0' \
        'umask 22' \
        '${payload}' \
        > ${job_file} && \
    chown root:root ${job_file} && \
    chmod 0700 ${job_file}
