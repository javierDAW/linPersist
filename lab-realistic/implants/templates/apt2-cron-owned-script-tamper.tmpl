# APT2 implant: apt2-cron-owned-script-tamper (Kinsing file-trojaning)
# A cron.d job runs an OWNED interpreter (/bin/bash) against a PACKAGE-OWNED
# shell script that is overwritten in place. exec_target=/bin/bash (owned,
# no orphan/non_package); the script ARGUMENT is owned-but-tampered ->
# package_file_tampered via the new VerifyPath-on-script-arg. Variables:
# ${cron_file}
RUN script="$$(find /usr/share /usr/lib -maxdepth 5 -type f -name '*.sh' 2>/dev/null | head -n1)"; \
    [ -n "$$script" ] || { echo "apt2-cron-owned-script-tamper: no packaged .sh found" >&2; exit 0; }; \
    printf '\n# lab inert marker apt2-cron-owned-script-tamper\n' >> "$$script"; \
    mkdir -p /etc/cron.d && \
    printf '%s\n' "*/10 * * * * root /bin/bash $$script" > ${cron_file} && \
    chown root:root ${cron_file} && chmod 0644 ${cron_file}
