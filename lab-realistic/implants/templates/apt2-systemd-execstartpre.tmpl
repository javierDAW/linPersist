# APT2 implant: apt2-systemd-execstartpre (Turla drop-in behavior injection)
# A drop-in into the vendor cron.service adds ExecStartPre pointing at a
# non-package /opt hook -> systemd_aux_exec_unmanaged. The drop-in carries
# no ExecStart of its own (first-ExecStart resolver missed it pre-duel).
# Variables: ${payload}, ${dropin}
RUN mkdir -p /opt/.svc && \
    printf '%s\n' '#!/bin/sh' 'exit 0' > ${payload} && \
    chown root:root ${payload} && chmod 0755 ${payload} && \
    mkdir -p /etc/systemd/system/cron.service.d && \
    printf '%s\n' '[Service]' 'ExecStartPre=${payload}' > ${dropin} && \
    chown root:root ${dropin} && chmod 0644 ${dropin}
