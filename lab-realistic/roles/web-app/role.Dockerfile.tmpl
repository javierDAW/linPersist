# Role: web-app
FROM linpersist-lab/${distro}-base:latest

RUN mkdir -p /var/www/${hostname}-app/releases/20240115 \
             /var/www/${hostname}-app/releases/20240722 && \
    ln -sf /var/www/${hostname}-app/releases/20240722 /var/www/${hostname}-app/current && \
    if [ "${runtime}" = "php" ]; then \
        printf '%s\n' '{}' > /var/www/${hostname}-app/current/composer.lock ; \
    else \
        printf '%s\n' '{"lockfileVersion": 3}' > /var/www/${hostname}-app/current/package-lock.json ; \
        mkdir -p /usr/lib/node_modules/pm2 && \
        printf '#!/bin/sh\nexec /bin/true\n' > /usr/local/bin/pm2 && chmod 0755 /usr/local/bin/pm2 ; \
    fi

RUN mkdir -p /etc/systemd/system /etc/systemd/system/${hostname}-app.service.d && \
    printf '%s\n' \
        '[Unit]' 'Description=${hostname} application' 'After=network.target' \
        '[Service]' \
        'Type=simple' 'User=www-data' \
        'WorkingDirectory=/var/www/${hostname}-app/current' \
        "ExecStart=$$( [ '${runtime}' = 'php' ] && echo '/usr/sbin/php-fpm -F' || echo '/usr/bin/node server.js' )" \
        'Restart=on-failure' \
        '[Install]' 'WantedBy=multi-user.target' \
        > /etc/systemd/system/${hostname}-app.service && \
    printf '%s\n' \
        '# Override: bump MemoryMax after the 2024-Q3 traffic ramp.' \
        '[Service]' 'MemoryMax=2G' 'CPUQuota=200%' \
        > /etc/systemd/system/${hostname}-app.service.d/local.conf

RUN mkdir -p /etc/cron.d && \
    printf '%s\n' \
        'SHELL=/bin/bash' \
        'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
        '*/5 * * * * www-data /var/www/${hostname}-app/current/bin/warm-cache.sh > /dev/null 2>&1' \
        '@hourly www-data find /var/www/${hostname}-app/current/storage/queues -mmin +60 -delete' \
        > /etc/cron.d/${hostname}-app && \
    chmod 0644 /etc/cron.d/${hostname}-app

RUN useradd -m -s /bin/bash deployer 2>/dev/null || true && \
    mkdir -p /home/deployer/.ssh && \
    printf 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA-deploykey-${hostname} deploy@bastion\n' \
        > /home/deployer/.ssh/authorized_keys && \
    chown -R deployer:deployer /home/deployer/.ssh && \
    chmod 0700 /home/deployer/.ssh && chmod 0600 /home/deployer/.ssh/authorized_keys

RUN echo "${provisioned_at_iso}" > /etc/lab.provisioned_at && \
    echo "role=web-app env=${env} datacenter=${datacenter} runtime=${runtime}" > /etc/lab.role-metadata
