# Role: mq
FROM linpersist-lab/${distro}-base:latest

RUN if [ "${engine}" = "rabbitmq" ]; then \
        mkdir -p /etc/rabbitmq /opt/rabbitmq/bin && \
        printf '#!/bin/sh\nexec sleep infinity\n' > /opt/rabbitmq/bin/rabbitmq-server && \
        chmod 0755 /opt/rabbitmq/bin/rabbitmq-server && \
        printf '%s\n' \
            'listeners.tcp.default = 5672' \
            'management.tcp.port = 15672' \
            '# Disable guest user post 2024-incident.' \
            'loopback_users.guest = true' \
            > /etc/rabbitmq/rabbitmq.conf && \
        printf '%s\n' \
            '{"users": [{"name":"app","password_hash":"redacted","tags":["administrator"]}]}' \
            > /etc/rabbitmq/definitions.json ; \
    else \
        mkdir -p /opt/kafka/config /opt/kafka/bin && \
        printf '%s\n' \
            'broker.id=1' \
            'log.dirs=/var/lib/kafka' \
            'num.partitions=3' \
            'default.replication.factor=2' \
            'auto.create.topics.enable=false' \
            > /opt/kafka/config/server.properties && \
        printf '#!/bin/sh\nexec sleep infinity\n' > /opt/kafka/bin/kafka-server-start.sh && \
        chmod 0755 /opt/kafka/bin/kafka-server-start.sh ; \
    fi

RUN echo "${provisioned_at_iso}" > /etc/lab.provisioned_at && \
    echo "role=mq env=${env} datacenter=${datacenter} engine=${engine}" > /etc/lab.role-metadata
