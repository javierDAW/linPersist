# Role: build-ci
# Vars: ${hostname}, ${distro}, ${env}, ${datacenter}, ${runtime}, ${provisioned_at_iso}
FROM linpersist-lab/${distro}-base:latest

# Vendor tools and runner binaries are stubs -- the agent reads
# their on-disk artifacts (cron drops, sudoers entries) not the
# binaries themselves.

RUN mkdir -p /usr/local/bin && \
    for tool in kubectl trivy hadolint docker; do \
        printf '#!/bin/sh\necho "lab-stub $$0"\n' > /usr/local/bin/$$tool && \
        chmod 0755 /usr/local/bin/$$tool ; \
    done

# Multiple JDKs vendor-installed.
RUN for v in 8 11 17 21; do \
        mkdir -p /opt/jdk-$$v/bin && \
        printf '#!/bin/sh\nexec /bin/true\n' > /opt/jdk-$$v/bin/java && \
        chmod 0755 /opt/jdk-$$v/bin/java ; \
    done

# Runner user + NOPASSWD sudoers entry (the v0.2.0 FP channel).
RUN if [ "${runtime}" = "jenkins" ]; then \
        useradd -m -s /bin/bash jenkins 2>/dev/null || true && \
        groupadd docker 2>/dev/null || true && \
        usermod -aG docker jenkins 2>/dev/null || true && \
        mkdir -p /etc/sudoers.d && \
        printf '%s\n' \
            '# Jenkins runner; managed by ops. JIRA-1284.' \
            'jenkins ALL=(ALL) NOPASSWD: ALL' \
            > /etc/sudoers.d/20-jenkins && \
        chmod 0440 /etc/sudoers.d/20-jenkins ; \
    else \
        useradd -m -s /bin/bash gitlab-runner 2>/dev/null || true && \
        groupadd docker 2>/dev/null || true && \
        usermod -aG docker gitlab-runner 2>/dev/null || true && \
        mkdir -p /etc/sudoers.d && \
        printf '%s\n' \
            '# GitLab Runner; managed by ops.' \
            'gitlab-runner ALL=(ALL) NOPASSWD: ALL' \
            > /etc/sudoers.d/20-gitlab-runner && \
        chmod 0440 /etc/sudoers.d/20-gitlab-runner ; \
    fi

# Docker daemon.json with insecure-registries entry.
RUN mkdir -p /etc/docker && \
    printf '%s\n' \
        '{' \
        '  "insecure-registries": ["registry.internal:5000"],' \
        '  "log-driver": "json-file",' \
        '  "log-opts": {"max-size": "10m", "max-file": "5"}' \
        '}' \
        > /etc/docker/daemon.json

RUN mkdir -p /opt/pyenv/shims && \
    printf '#!/bin/sh\nexec /bin/echo python3 "$$@"\n' > /opt/pyenv/shims/python && \
    chmod 0755 /opt/pyenv/shims/python

RUN mkdir -p /etc/cron.d && \
    printf '%s\n' \
        'SHELL=/bin/bash' \
        '0 4 * * * root find /var/cache/ci -mtime +14 -delete' \
        > /etc/cron.d/ci-cache-evict && \
    chmod 0644 /etc/cron.d/ci-cache-evict

RUN echo "${provisioned_at_iso}" > /etc/lab.provisioned_at && \
    echo "role=build-ci env=${env} datacenter=${datacenter} runtime=${runtime}" > /etc/lab.role-metadata
