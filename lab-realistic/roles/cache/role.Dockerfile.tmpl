# Role: cache
# Vars: ${hostname}, ${distro}, ${env}, ${datacenter}, ${engine}, ${provisioned_at_iso}
FROM linpersist-lab/${distro}-base:latest

RUN mkdir -p /etc/redis /etc/memcached && \
    if [ "${engine}" = "redis" ]; then \
        printf '%s\n' \
            'bind 0.0.0.0' \
            'protected-mode yes' \
            'port 6379' \
            'maxmemory 4gb' \
            'maxmemory-policy allkeys-lru' \
            '# AOF on after 2024-Q2 data-loss incident.' \
            'appendonly yes' \
            'appendfsync everysec' \
            > /etc/redis/redis.conf && \
        printf '%s\n' \
            'port 26379' \
            'sentinel monitor mymaster 10.0.3.10 6379 2' \
            'sentinel down-after-milliseconds mymaster 5000' \
            > /etc/redis/sentinel.conf ; \
    else \
        printf '%s\n' '-m 4096' '-c 4096' '-l 0.0.0.0' > /etc/memcached.conf ; \
    fi

RUN mkdir -p /etc/sysctl.d && \
    printf '%s\n' \
        '# Tuning for redis/memcached -- 2023-09.' \
        'net.core.somaxconn = 1024' \
        'net.ipv4.tcp_max_syn_backlog = 4096' \
        'vm.overcommit_memory = 1' \
        > /etc/sysctl.d/99-cache.conf

RUN mkdir -p /opt/prometheus-exporters/bin /etc/systemd/system && \
    printf '#!/bin/sh\nexec sleep infinity\n' > /opt/prometheus-exporters/bin/redis_exporter && \
    chmod 0755 /opt/prometheus-exporters/bin/redis_exporter && \
    printf '%s\n' \
        '[Unit]' 'Description=redis_exporter' \
        '[Service]' 'ExecStart=/opt/prometheus-exporters/bin/redis_exporter' \
        '[Install]' 'WantedBy=multi-user.target' \
        > /etc/systemd/system/redis-exporter.service

RUN echo "${provisioned_at_iso}" > /etc/lab.provisioned_at && \
    echo "role=cache env=${env} datacenter=${datacenter} engine=${engine}" > /etc/lab.role-metadata
