# Role: bastion
# Vars: ${hostname}, ${distro}, ${env}, ${datacenter}, ${provisioned_at_iso}
FROM linpersist-lab/${distro}-base:latest

# sshd_config with AuthorizedKeysCommand pointing at vault-cli.
RUN mkdir -p /etc/ssh && \
    printf '%s\n' \
        'Port 22' \
        'PermitRootLogin no' \
        'PasswordAuthentication no' \
        'PubkeyAuthentication yes' \
        'AuthenticationMethods publickey,keyboard-interactive' \
        '# 2024-Q1: vault-issued ephemeral SSH certs.' \
        'AuthorizedKeysCommand /opt/vault-cli/bin/ssh-keys %u' \
        'AuthorizedKeysCommandUser nobody' \
        'AllowTcpForwarding yes' \
        'ClientAliveInterval 300' \
        'Match Group sysadmin' \
        '    ForceCommand /usr/local/bin/rbash-wrapper' \
        > /etc/ssh/sshd_config

RUN mkdir -p /opt/vault-cli/bin && \
    printf '#!/bin/sh\necho "ssh-ed25519 AAAA-lab-stub vault@$$1"\n' > /opt/vault-cli/bin/ssh-keys && \
    chmod 0755 /opt/vault-cli/bin/ssh-keys

# PAM stack with yubikey override.
RUN mkdir -p /etc/pam.d /etc/yubikey && \
    printf '%s\n' \
        '# /etc/pam.d/sshd -- 2024-Q2 added yubikey requirement.' \
        'auth required pam_yubico.so id=12345 authfile=/etc/yubikey/authorized_yubikeys debug' \
        '@include common-auth' \
        '@include common-account' \
        '@include common-session' \
        > /etc/pam.d/sshd

# auditd rules drop-in (the daemon may or may not be installed;
# linpersist only reads /etc/audit/rules.d/).
RUN mkdir -p /etc/audit/rules.d && \
    printf '%s\n' \
        '-w /etc/passwd -p wa -k identity' \
        '-w /etc/shadow -p wa -k identity' \
        '-w /etc/sudoers -p wa -k sudo' \
        '-w /etc/ssh/sshd_config -p wa -k sshd' \
        '-a always,exit -F arch=b64 -S execve -F euid=0 -k root-exec' \
        > /etc/audit/rules.d/90-bastion.rules

RUN printf '%s\n' \
        '#!/bin/sh' \
        'case "$$SSH_ORIGINAL_COMMAND" in' \
        '    kubectl*|git*|ssh*) exec $$SSH_ORIGINAL_COMMAND ;;' \
        '    *) echo "rbash: command not allowed"; exit 1 ;;' \
        'esac' \
        > /usr/local/bin/rbash-wrapper && chmod 0755 /usr/local/bin/rbash-wrapper

RUN mkdir -p /etc/security/limits.d && \
    printf '%s\n' \
        '@sysadmin   soft  nofile   65535' \
        '@sysadmin   hard  nofile   131072' \
        '@developer  soft  nofile   8192' \
        > /etc/security/limits.d/10-team-limits.conf

# Splunk Forwarder vendor binary.
RUN mkdir -p /opt/splunkforwarder/bin /opt/splunkforwarder/etc && \
    printf '#!/bin/sh\nexec sleep infinity\n' > /opt/splunkforwarder/bin/splunkd && \
    chmod 0755 /opt/splunkforwarder/bin/splunkd && \
    printf '[default]\nuseragent = lab-stub\n' > /opt/splunkforwarder/etc/splunk.conf && \
    mkdir -p /etc/systemd/system && \
    printf '%s\n' \
        '[Unit]' 'Description=Splunk Forwarder (vendor)' \
        '[Service]' 'ExecStart=/opt/splunkforwarder/bin/splunkd start --nodaemon' \
        '[Install]' 'WantedBy=multi-user.target' \
        > /etc/systemd/system/splunkforwarder.service

# DataDog agent.
RUN mkdir -p /opt/datadog-agent/bin && \
    printf '#!/bin/sh\nexec sleep infinity\n' > /opt/datadog-agent/bin/datadog-agent && \
    chmod 0755 /opt/datadog-agent/bin/datadog-agent

# Sudo Defaults.
RUN mkdir -p /etc/sudoers.d && \
    printf '%s\n' \
        '# Bastion-wide sudo policy.' \
        'Defaults     log_input,log_output' \
        'Defaults     iolog_dir="/var/log/sudo-io/%{user}"' \
        'Defaults     env_keep += "VAULT_TOKEN VAULT_ADDR"' \
        '%sysadmin ALL=(ALL) ALL' \
        > /etc/sudoers.d/00-defaults && \
    chmod 0440 /etc/sudoers.d/00-defaults

RUN echo "${provisioned_at_iso}" > /etc/lab.provisioned_at && \
    echo "role=bastion env=${env} datacenter=${datacenter}" > /etc/lab.role-metadata
