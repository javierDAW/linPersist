// --- Q11 single-host variant -----------------------------------------

// computeHostOrphanOutsideTmp returns the host's own exec_targets that
// carry non_package_path AND are NOT under tmp-class prefixes. Unlike
// the fleet Q11 this version is not LFA-sorted (singletons-first is
// meaningless for a single host); it sorts alphabetically by target
// for diff stability.
func computeHostOrphanOutsideTmp(hostRecords []core.Record) []OrphanOutsideTmpRow {
	tmpPrefixes := []string{"/tmp/", "/var/tmp/", "/dev/shm/", "/run/shm/"}
	type agg struct {
		records       int
		module        string
		siteClass     string
		sampleLocus   string
		sampleSnippet string
		host          string
	}
	m := map[string]*agg{}
	for _, r := range hostRecords {
		if r.ExecTarget == "" {
			continue
		}
		inTmp := false
		for _, p := range tmpPrefixes {
			if strings.HasPrefix(r.ExecTarget, p) {
				inTmp = true
				break
			}
		}
		if inTmp {
			continue
		}
		hasFlag := false
		for _, s := range r.Signals {
			if s == core.SignalNonPackagePath {
				hasFlag = true
				break
			}
		}
		if !hasFlag {
			continue
		}
		a := m[r.ExecTarget]
		if a == nil {
			a = &agg{
				module:        r.Module,
				siteClass:     r.SiteClass,
				sampleLocus:   r.Locus,
				sampleSnippet: r.ContentSnippet,
				host:          hostKey(r),
			}
			m[r.ExecTarget] = a
		}
		a.records++
	}
	out := make([]OrphanOutsideTmpRow, 0, len(m))
	for target, a := range m {
		out = append(out, OrphanOutsideTmpRow{
			ExecTarget:    target,
			Hosts:         1, // dossier scope: this host
			Records:       a.records,
			Module:        a.module,
			SiteClass:     a.siteClass,
			SampleHost:    a.host,
			SampleLocus:   a.sampleLocus,
			SampleSnippet: snippetTrim(a.sampleSnippet, 100),
		})
	}
	sort.Slice(out, func(i, j int) bool { return out[i].ExecTarget < out[j].ExecTarget })
	return out
}

// --- Q8 single-host variant ------------------------------------------

// computeHostMtimeSpikes returns the host's per-module recent-mtime
// counts. Threshold matches the fleet Q8: >= 5 records carrying
// recent_mtime_7d on a (host, module) pair. Rows below the threshold
// are omitted.
func computeHostMtimeSpikes(hostRecords []core.Record) []MtimeConcRow {
	perModule := map[string]struct {
		records int
		loci    map[string]struct{}
	}{}
	for _, r := range hostRecords {
		hasRecent := false
		for _, s := range r.Signals {
			if s == core.SignalRecentMtime7d {
				hasRecent = true
				break
			}
		}
		if !hasRecent {
			continue
		}
		agg := perModule[r.Module]
		if agg.loci == nil {
			agg.loci = map[string]struct{}{}
		}
		agg.records++
		agg.loci[r.Locus] = struct{}{}
		perModule[r.Module] = agg
	}
	var out []MtimeConcRow
	const threshold = 5
	for mod, agg := range perModule {
		if agg.records < threshold {
			continue
		}
		out = append(out, MtimeConcRow{
			Host:          "", // omitted in dossier — entire table is for one host
			Module:        mod,
			RecentRecords: agg.records,
			RecentLoci:    len(agg.loci),
		})
	}
	sort.Slice(out, func(i, j int) bool {
		if out[i].RecentRecords != out[j].RecentRecords {
			return out[i].RecentRecords > out[j].RecentRecords
		}
		return out[i].Module < out[j].Module
	})
	return out
}

// --- module coverage / gap detector -----------------------------------

func computeHostModuleCoverage(allRecords, hostRecords []core.Record) []HostModuleRow {
	// Fleet view: per (module, host) record count. Used to compute
	// the per-module median across hosts that emit anything for that
	// module — this avoids gaming the median with the many zeros from
	// hosts that lack the module entirely.
	type modHost struct{ mod, host string }
	fleetCount := map[modHost]int{}
	modulesSeen := map[string]struct{}{}
	for _, r := range allRecords {
		fleetCount[modHost{r.Module, hostKey(r)}]++
		modulesSeen[r.Module] = struct{}{}
	}

	// Bucket per module across hosts that emit it.
	perModule := map[string][]int{}
	for k, n := range fleetCount {
		perModule[k.mod] = append(perModule[k.mod], n)
	}
	median := func(mod string) int {
		v := perModule[mod]
		if len(v) == 0 {
			return 0
		}
		sort.Ints(v)
		return v[len(v)/2]
	}

	// Host view: per-module record + site_class count.
	hostCount := map[string]int{}
	hostSiteClasses := map[string]map[string]struct{}{}
	for _, r := range hostRecords {
		hostCount[r.Module]++
		set := hostSiteClasses[r.Module]
		if set == nil {
			set = map[string]struct{}{}
			hostSiteClasses[r.Module] = set
		}
		set[r.SiteClass] = struct{}{}
	}

	out := make([]HostModuleRow, 0, len(modulesSeen))
	for mod := range modulesSeen {
		recs := hostCount[mod]
		m := median(mod)
		out = append(out, HostModuleRow{
			Module:      mod,
			Records:     recs,
			SiteClasses: len(hostSiteClasses[mod]),
			FleetMedian: m,
			IsGap:       recs == 0 && m > 0,
		})
	}
	// Gaps first, then alphabetical. Inside the gap-class the most
	// "expected" modules (highest fleet median) bubble to the top.
	sort.Slice(out, func(i, j int) bool {
		if out[i].IsGap != out[j].IsGap {
			return out[i].IsGap
		}
		if out[i].IsGap && out[j].IsGap {
			if out[i].FleetMedian != out[j].FleetMedian {
				return out[i].FleetMedian > out[j].FleetMedian
			}
		}
		return out[i].Module < out[j].Module
	})
	return out
}

// --- misc helpers -----------------------------------------------------

// countDistinct returns the number of distinct keys produced by f
// across records.
func countDistinct(records []core.Record, f func(core.Record) string) int {
	seen := map[string]struct{}{}
	for _, r := range records {
		seen[f(r)] = struct{}{}
	}
	return len(seen)
}
